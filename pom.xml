<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.atomikos</groupId>
	<artifactId>spring-boot-sample-jta-atomikos-logcloud</artifactId>
	<version>1.0.0</version>
	<name>Spring Boot Atomikos LogCloud demo</name>
	<description>Crash one node in the middle of an XA commit - and watch another node finish it from the LogCloud transaction log in PostgreSQL.</description>
	<properties>
		<java.version>17</java.version>
		<atomikos.version>6.0.121-SNAPSHOT</atomikos.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- the right (jakarta or not) variant of every ExtremeTransactions artifact -->
			<dependency>
				<groupId>com.atomikos</groupId>
				<artifactId>extreme-transactions-jakarta</artifactId>
				<version>${atomikos.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- Atomikos: JTA transaction manager + XA DataSource + XA ConnectionFactory
		     (not in the BOM, hence the version) -->
		<dependency>
			<groupId>com.atomikos</groupId>
			<artifactId>transactions-spring-boot4-starter</artifactId>
			<version>${atomikos.version}</version>
		</dependency>
		<!-- Atomikos LogCloud: the transaction log lives in the database instead of on local disk.
		     Brings transactions-logcloud and the remoting modules it needs. -->
		<dependency>
			<groupId>com.atomikos</groupId>
			<artifactId>transactions-spring-boot4-logcloud</artifactId>
		</dependency>
		<!-- needed at runtime by transactions-remoting, but provided-scope there -->
		<dependency>
			<groupId>jakarta.ws.rs</groupId>
			<artifactId>jakarta.ws.rs-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-artemis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<!-- starts compose.yaml (PostgreSQL + Artemis) on mvn spring-boot:run -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-activemq</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
